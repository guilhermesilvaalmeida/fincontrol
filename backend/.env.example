DATABASE_URL=jdbc:postgresql://localhost:5432/fincontrol
DATABASE_USERNAME=fincontrol
DATABASE_PASSWORD=fincontrol

# NUNCA use este valor em produção. Gere o seu com:
#   openssl rand -base64 48
# ou (Python): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret-in-production-please-0123456789
JWT_EXPIRATION_MINUTES=1440

# Em produção, liste APENAS o domínio real do seu frontend (sem coringa "*")
CORS_ORIGINS=http://localhost:3000
PORT=8080
